##################################################################
#
#   This macro instructs RefFIT to perform the actions described
#   in the RefFIT Manual (Tutorial section 3.3.1)
#
#   It performs the KK analysis of a reflectivity spectrum R1.DAT from directory "..\PART1",
#   using the KK-constrained variational dielectric function
# 
#   Written by A.Kuzmenko (2005)
#
##################################################################

#------------------------------------------------------------------------------------
# sets the dimensions and the title of the main (application) window 
MainWindow(XPos = 0, YPos = 0, Width = 1024, Height = 740, Title = "KK analysis of reflectivity");

#------------------------------------------------------------------------------------
# loads reflectivity

# here the frequency set is generated by RefFIT (XMethod = 3)
LoadDataset(DatasetNo = 1, Quantity = "R", MasterFile = "..\PART1\R1.DAT", XMethod = 3, 
	Xmin = 20.0, Xmax = 2000.0, XPts = 1500, XGrid = 1);

#------------------------------------------------------------------------------------

# creates a model (which is AUTOMATICALLY ascribed ModelNo = 1)
NewModel(XPos = 0, YPos = 80, Width = 300, Height = 300, VarDielFuncSeen = 1);

# loads a saved model file into the model window
LoadModel(ModelNo = 1, File = "..\PART1\MODEL3.RFM");

#------------------------------------------------------------------------------------

# makes and sets up three graph windows

# creates a graph to plot reflectivity
NewGraph(XPos = 300, YPos = 80, Width = 710, Height = 320);

# sets the graph properties
GraphProperties(GraphNo = 1, Xmin = 0, Xmax = 1000.0, Xlog = 0, 
	Ymin = 0.0, Ymax = 1.0, Ylog = 0, YTitle = "Reflectivity");

# plots the dataset #1
AddDataCurve(GraphNo = 1, DatasetNo = 1, nColor = 0, ShowLine = 1, ShowSymbol = 1, 
	ShowError = 0, nSymbolSize = 1, nSymbolShape = 0, SymbolOpen = 1, Scale = 1.0, Shift = 0.0);

# plots a reflectivity curve, generated by the model #1
AddModelCurve(GraphNo = 1, ModelNo = 1, Quantity = "R", nColor = 0,  Scale = 1.0, Shift = 0.0);

# creates a graph to plot conductivity
NewGraph(XPos = 300, YPos = 400, Width = 710, Height = 320);

# sets the graph properties
GraphProperties(GraphNo = 2, Xmin = 0.0, Xmax = 1000.0, Xlog = 0, 
	Ymin = 0.0, Ymax = 50.0, Ylog = 0, YTitle = "Sigma1 (S/cm)");

AddModelCurve(GraphNo = 2, ModelNo = 1, Quantity = "S1", nColor = 0,  Scale = 1.0, Shift = 0.0);

#------------------------------------------------------------------------------------

# opens the "Fit" window 
WindowFit(Xpos = 0, YPos = 400);

# adds four chi-square terms to the fitting task, which means that all datasets are requested 
#to be fitted, but does not perform fitting yet
AddChiSqTerm(DatasetNo = 1, ModelNo = 1, Weight = 1);

#------------------------------------------------------------------------------------

# performs the fitting, which is limited to 10 iterations
Wait(Time = 1000);
Fit(NumIters = 10);

# fixes all parameters except Einf, and Drude Wp and G

FixAllModelParams(ModelNo = 1);
SetModelParam(ModelNo = 1, ParamName = "Einf", FitActive = 1);
SetModelParam(ModelNo = 1, ParamName = "Wp", LorNo = 1, FitActive = 1);
SetModelParam(ModelNo = 1, ParamName = "G", LorNo = 1, FitActive = 1);

# adds a variational dielectric function, which anchor mesh contains every second frequency point 
# from the reflectivity dataset

VarDielFunc(ModelNo = 1, Source1DatasetNo = 1, Source1Every2nd = 1);

# performs the fitting again with the variational function, which is limited to 3 iterations
Wait(Time = 1000);
Fit(NumIters = 3);

#------------------------------------------------------------------------------------

# exports the optical conductivity, which includes now the contribution from the variational dielectric function
ExportModelCurve(File = "S1.DAT", ModelNo = 1, Quantity = "S1", Xmin = 20, Xmax = 2000, XPts = 1500, XGrid = 1);



