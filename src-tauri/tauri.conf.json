{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lightmatter Desktop",
  "version": "0.1.0",
  "identifier": "com.goldevlab.lightmatter",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lightmatter",
        "url": "http://127.0.0.1:4321",
        "width": 1440,
        "height": 980,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/GoldevLab/lightmatter-kk/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "externalBin": [
      "binaries/lightmatter"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../public/**/*",
      "../src/pages/**/*"
    ]
  }
}
