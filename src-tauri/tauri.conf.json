{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lightmatter Desktop",
  "version": "0.1.0",
  "identifier": "com.goldevlab.lightmatter",
  "build": {
    "beforeDevCommand": "cargo run --bin lightmatter",
    "beforeBuildCommand": "cargo build --release --bin lightmatter",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lightmatter",
        "url": "http://127.0.0.1:4321",
        "width": 1440,
        "height": 980,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../target/release/lightmatter.exe"
    ]
  }
}
