{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lightmatter Desktop",
  "version": "0.1.0",
  "identifier": "com.goldevlab.lightmatter",
  "build": {
    "beforeDevCommand": "cargo run --bin lightmatter",
    "beforeBuildCommand": "cargo build --release --bin lightmatter",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lightmatter",
        "width": 1440,
        "height": 980,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
