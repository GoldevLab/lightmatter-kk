{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lightmatter Desktop",
  "version": "0.1.0",
  "identifier": "com.goldevlab.lightmatter",
  "build": {
    "beforeDevCommand": "powershell -ExecutionPolicy Bypass -File ../scripts/build-desktop.ps1",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File ../scripts/build-desktop.ps1",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lightmatter",
        "width": 1440,
        "height": 980,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/GoldevLab/lightmatter-kk/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "zip"
    ],
    "externalBin": [
      "binaries/lightmatter"
    ],
    "icon": []
  }
}
